                                <span class="text-[11px] text-gray-400">Seguidores</span>
                            </button>
                            <button onclick="openFollowersModal('following')" class="text-center group">
                                <span id="count-following" class="block text-xl font-extrabold text-white group-hover:text-[var(--accent-color)]">8</span>
                                <span class="text-[11px] text-gray-400">Siguiendo</span>
