        // --- BOLA DE AGUA (CANVAS INTERACTIVO FLOTANTE) ---
        function initWaterSphere() {
            const canvas = document.getElementById('water-sphere-canvas');
            const ctx = canvas.getContext('2d');

            let width = canvas.width;
            let height = canvas.height;
            let step = 0;

            // Arrastre simple de la esfera
            let isDragging = false;
            let offsetX = 0, offsetY = 0;

            canvas.addEventListener('mousedown', (e) => {
                isDragging = true;
                offsetX = e.clientX - canvas.offsetLeft;
                offsetY = e.clientY - canvas.offsetTop;
            });

            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                canvas.style.left = (e.clientX - offsetX) + 'px';
                canvas.style.top = (e.clientY - offsetY) + 'px';
                canvas.style.bottom = 'auto';
                canvas.style.right = 'auto';
            });

            window.addEventListener('mouseup', () => isDragging = false);

            function animate() {
                ctx.clearRect(0, 0, width, height);

                const accentColor = getComputedStyle(document.body).getPropertyValue('--accent-color').trim() || '#00f0ff';

                // Fondo base circular
                ctx.beginPath();
                ctx.arc(width/2, height/2, 38, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(10, 13, 20, 0.7)';
                ctx.fill();
                ctx.lineWidth = 2;
                ctx.strokeStyle = accentColor;
                ctx.stroke();

                // Animación de Ola de agua interna
                ctx.save();
                ctx.beginPath();
                ctx.arc(width/2, height/2, 36, 0, Math.PI * 2);
                ctx.clip();

                ctx.beginPath();
                step += 0.05;

                for (let x = 0; x <= width; x++) {
                    const y = Math.sin(x * 0.08 + step) * 5 + (height / 2 + 5);
                    if (x === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }

                ctx.lineTo(width, height);
                ctx.lineTo(0, height);
                ctx.closePath();

                ctx.fillStyle = accentColor;
                ctx.globalAlpha = 0.5;
                ctx.fill();

                // Burbujas internas
                ctx.fillStyle = '#ffffff';
                ctx.globalAlpha = 0.8;
                for (let i = 0; i < 3; i++) {
                    const bx = (width/2 - 15) + (i * 12) + Math.sin(step + i) * 3;
                    const by = (height/2 + 10) - ((step * 10 + i * 15) % 30);
                    ctx.beginPath();
                    ctx.arc(bx, by, 2, 0, Math.PI * 2);
