<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>♤corp♤ Messenger & Reals</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome para Iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Outfit:wght@400;600;800&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        corp: {
                            dark: '#0a0d14',
                            card: '#121824',
                            accent: 'var(--accent-color)',
                            accentGlow: 'var(--accent-glow)'
                        }
                    },
                    fontFamily: {
                        sans: ['var(--font-family)', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --accent-color: #00f0ff;
            --accent-glow: rgba(0, 240, 255, 0.4);
            --accent-gradient: linear-gradient(135deg, #00f0ff 0%, #7000ff 100%);
            --font-family: 'Outfit';
            --glow-intensity: 15px;
        }

        /* Temas Neón */
        body.theme-cyan {
            --accent-color: #00f0ff;
            --accent-glow: rgba(0, 240, 255, 0.4);
            --accent-gradient: linear-gradient(135deg, #00f0ff 0%, #0072ff 100%);
        }
        body.theme-aurora {
            --accent-color: #00ff88;
            --accent-glow: rgba(0, 255, 136, 0.4);
            --accent-gradient: linear-gradient(135deg, #00ff88 0%, #60efff 100%);
        }
        body.theme-cyber {
            --accent-color: #ff007f;
            --accent-glow: rgba(255, 0, 127, 0.4);
            --accent-gradient: linear-gradient(135deg, #ff007f 0%, #7f00ff 100%);
        }
        body.theme-amber {
            --accent-color: #ffaa00;
            --accent-glow: rgba(255, 170, 0, 0.4);
            --accent-gradient: linear-gradient(135deg, #ffaa00 0%, #ff0055 100%);
        }
        body.theme-ice {
            --accent-color: #a855f7;
            --accent-glow: rgba(168, 85, 247, 0.4);
            --accent-gradient: linear-gradient(135deg, #a855f7 0%, #3b82f6 100%);
        }

        /* Tipografías */
        body.font-modern { --font-family: 'Outfit'; }
        body.font-elegant { --font-family: 'Playfair Display'; }
        body.font-rounded { --font-family: 'Inter'; }
        body.font-mono { --font-family: 'JetBrains Mono'; }

        body {
            font-family: var(--font-family);
            background-color: #07090e;
            color: #e2e8f0;
            overflow-x: hidden;
            user-select: none;
        }

        .glow-effect {
            box-shadow: 0 0 var(--glow-intensity) var(--accent-glow);
        }

        .glow-text {
            text-shadow: 0 0 10px var(--accent-glow);
        }

        .glass-panel {
            background: rgba(18, 24, 36, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Scrollbar Neón */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(10, 13, 20, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent-color);
        }

        /* Animación Esfera Agua Canvas */
        #water-sphere-canvas {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 40;
            cursor: grab;
            touch-action: none;
            filter: drop-shadow(0 0 12px var(--accent-glow));
        }
        #water-sphere-canvas:active {
            cursor: grabbing;
        }

        .btn-neon {
            background: var(--accent-gradient);
            color: #000;
            font-weight: 700;
            transition: all 0.3s ease;
        }
        .btn-neon:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            box-shadow: 0 0 20px var(--accent-glow);
        }

        .badge-pin {
            background: rgba(0, 240, 255, 0.15);
            border: 1px solid var(--accent-color);
            color: var(--accent-color);
        }
    </style>
</head>
<body class="theme-cyan font-modern antialiased min-h-screen flex flex-col justify-between">

    <!-- CANVAS ESFERA FLOTANTE "BOLA DE AGUA" -->
    <canvas id="water-sphere-canvas" width="90" height="90" class="transition-opacity duration-300"></canvas>

    <!-- PANTALLA DE BIENVENIDA / REGISTRO (INICIO DE SESIÓN) -->
    <div id="auth-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md hidden">
        <div class="glass-panel w-full max-w-md p-8 rounded-3xl border border-white/10 relative overflow-hidden shadow-2xl">
            <div class="text-center mb-6">
                <h1 class="text-4xl font-extrabold tracking-wider text-white mb-2">♤corp♤</h1>
                <p class="text-xs tracking-widest text-gray-400 uppercase">Mensajería Privada y Red Neón</p>
            </div>
            <form id="auth-form" onsubmit="registerUser(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-1">Nombre completo o Alias</label>
                    <input type="text" id="auth-name" required placeholder="Ej: Alex Mercer" class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[var(--accent-color)] transition-colors">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-1">Fecha de Nacimiento</label>
                    <input type="date" id="auth-dob" required class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[var(--accent-color)] transition-colors">
                </div>
                <div class="p-3 glass-card rounded-xl border border-white/5 text-xs text-gray-400 flex items-center gap-3">
                    <i class="fa-solid fa-shield-halved text-lg text-[var(--accent-color)]"></i>
                    <span>Se generará una credencial y un PIN de contacto seguro en tu navegador.</span>
                </div>
                <button type="submit" class="w-full btn-neon py-3.5 rounded-xl font-bold tracking-wide mt-2">
                    Ingresar a ♤corp♤
                </button>
            </form>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL APP -->
    <div id="app-container" class="flex-1 flex flex-col md:flex-row h-screen overflow-hidden relative">

        <!-- NAVEGACIÓN LATERAL / BOTTOM NAV (MÓVIL) -->
        <aside class="w-full md:w-20 lg:w-24 glass-panel flex md:flex-col items-center justify-between p-3 md:py-6 order-2 md:order-1 z-30 border-t md:border-t-0 md:border-r border-white/10">
            <div class="hidden md:flex flex-col items-center gap-1 mb-6">
                <span class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">♤</span>
            </div>
            
            <nav class="flex md:flex-col justify-around w-full md:w-auto gap-2 md:gap-6">
                <button onclick="switchTab('chats')" id="nav-chats" class="nav-btn active flex flex-col items-center p-2 text-gray-400 hover:text-white transition-colors relative">
                    <i class="fa-solid fa-comments text-xl mb-1"></i>
                    <span class="text-[10px] tracking-wider">Chats</span>
                </button>
                <button onclick="switchTab('reals')" id="nav-reals" class="nav-btn flex flex-col items-center p-2 text-gray-400 hover:text-white transition-colors relative">
                    <i class="fa-solid fa-clapperboard text-xl mb-1"></i>
                    <span class="text-[10px] tracking-wider">Reals</span>
                </button>
                <button onclick="switchTab('network')" id="nav-network" class="nav-btn flex flex-col items-center p-2 text-gray-400 hover:text-white transition-colors relative">
                    <i class="fa-solid fa-wifi text-xl mb-1"></i>
                    <span class="text-[10px] tracking-wider">Red</span>
                </button>
                <button onclick="switchTab('profile')" id="nav-profile" class="nav-btn flex flex-col items-center p-2 text-gray-400 hover:text-white transition-colors relative">
                    <i class="fa-solid fa-user-gear text-xl mb-1"></i>
                    <span class="text-[10px] tracking-wider">Perfil</span>
                </button>
            </nav>

            <div class="hidden md:flex flex-col items-center gap-3">
                <button onclick="openSettingsModal()" class="w-10 h-10 rounded-xl glass-card flex items-center justify-center text-gray-400 hover:text-white hover:border-white/20 transition-all">
                    <i class="fa-solid fa-sliders"></i>
                </button>
            </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL SECCIONES -->
        <main class="flex-1 flex overflow-hidden order-1 md:order-2">

            <!-- SECCIÓN 1: CHATS -->
            <section id="sec-chats" class="tab-content flex-1 flex flex-col md:flex-row h-full">
                <!-- Lista de Conversaciones -->
                <div class="w-full md:w-80 lg:w-96 glass-panel border-r border-white/10 flex flex-col h-full">
                    <div class="p-4 border-b border-white/10 flex items-center justify-between">
                        <div>
                            <h2 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
                                Mensajes <span class="text-xs px-2 py-0.5 rounded-full badge-pin" id="my-pin-display">#PIN</span>
                            </h2>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="openNewChatModal()" class="w-9 h-9 rounded-xl btn-neon flex items-center justify-center text-black text-sm">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                            <button onclick="openSettingsModal()" class="md:hidden w-9 h-9 rounded-xl glass-card flex items-center justify-center text-gray-300">
                                <i class="fa-solid fa-sliders"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Buscador -->
                    <div class="p-3">
                        <div class="relative">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-xs text-gray-400"></i>
                            <input type="text" id="chat-search" oninput="filterChats()" placeholder="Buscar por contacto o PIN..." class="w-full bg-black/40 border border-white/10 rounded-xl pl-9 pr-3 py-2 text-xs text-white focus:outline-none focus:border-[var(--accent-color)]">
                        </div>
                    </div>

                    <!-- Lista de Chats -->
                    <div id="chats-list" class="flex-1 overflow-y-auto divide-y divide-white/5">
                        <!-- Generado dinámicamente -->
                    </div>
                </div>

                <!-- Ventana de Chat Activo -->
                <div id="active-chat-container" class="hidden md:flex flex-1 flex-col h-full bg-black/40 relative">
                    <!-- Placeholder Vacio -->
                    <div id="no-chat-selected" class="flex-1 flex flex-col items-center justify-center text-center p-6 text-gray-500">
                        <div class="w-20 h-20 rounded-full glass-card flex items-center justify-center mb-4 text-3xl text-gray-600">
                            <i class="fa-solid fa-paper-plane"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-300">♤corp♤ Encripción Local</h3>
                        <p class="text-xs max-w-sm mt-1">Selecciona una conversación o añade un contacto con su PIN para comenzar a interactuar.</p>
                    </div>

                    <!-- Chat UI Activa -->
                    <div id="chat-window" class="hidden flex-1 flex-col h-full overflow-hidden">
                        <!-- Cabecera Chat -->
                        <div class="p-4 glass-panel border-b border-white/10 flex items-center justify-between z-10">
                            <div class="flex items-center gap-3">
                                <button onclick="closeChatMobile()" class="md:hidden text-gray-400 hover:text-white mr-1">
                                    <i class="fa-solid fa-arrow-left"></i>
                                </button>
                                <div class="relative">
                                    <div id="chat-avatar" class="w-10 h-10 rounded-xl btn-neon flex items-center justify-center text-black font-bold text-sm">
                                        AC
                                    </div>
                                    <span id="chat-status-dot" class="w-3 h-3 bg-emerald-500 rounded-full absolute -bottom-1 -right-1 border-2 border-black"></span>
                                </div>
                                <div>
                                    <h3 id="chat-title" class="font-bold text-white text-sm">Contacto</h3>
                                    <p id="chat-subtitle" class="text-[11px] text-gray-400">PIN: #0000</p>
                                </div>
                            </div>

                            <div class="flex items-center gap-2">
                                <button onclick="shareContactPin()" class="p-2 text-xs text-gray-400 hover:text-white glass-card rounded-lg" title="Compartir Mi PIN">
                                    <i class="fa-solid fa-share-nodes"></i>
                                </button>
                                <button id="btn-toggle-block" onclick="toggleBlockContact()" class="p-2 text-xs text-red-400 hover:text-red-300 glass-card rounded-lg">
                                    <i class="fa-solid fa-ban"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Barra de Mensaje Fijado -->
                        <div id="pinned-message-bar" class="hidden px-4 py-2 bg-[var(--accent-glow)]/10 border-b border-[var(--accent-color)]/30 flex items-center justify-between text-xs">
                            <div class="flex items-center gap-2 truncate">
                                <i class="fa-solid fa-thumbtack text-[var(--accent-color)]"></i>
                                <span class="text-gray-300">Fijado:</span>
                                <span id="pinned-text" class="text-white font-medium truncate">--</span>
                            </div>
                            <button onclick="unpinMessage()" class="text-gray-400 hover:text-white text-xs ml-2">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <!-- Mensajes Area -->
                        <div id="messages-container" class="flex-1 overflow-y-auto p-4 space-y-3">
                            <!-- Mensajes Renderizados -->
                        </div>

                        <!-- Formulario Enviar -->
                        <div class="p-3 glass-panel border-t border-white/10">
                            <form id="chat-input-form" onsubmit="sendMessage(event)" class="flex items-center gap-2">
                                <input type="text" id="chat-input" placeholder="Escribe un mensaje neón..." class="flex-1 bg-black/60 border border-white/10 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-[var(--accent-color)]">
                                <button type="submit" class="btn-neon px-4 py-2.5 rounded-xl text-xs font-bold flex items-center gap-2">
                                    <span>Enviar</span>
                                    <i class="fa-solid fa-paper-plane"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECCIÓN 2: REALS (HISTORIAS / REELS) -->
            <section id="sec-reals" class="tab-content hidden flex-1 flex flex-col h-full bg-black/60 overflow-y-auto p-4 lg:p-6">
                <div class="max-w-4xl mx-auto w-full space-y-6">
                    <div class="flex items-center justify-between border-b border-white/10 pb-4">
                        <div>
                            <h2 class="text-2xl font-black text-white tracking-wide">♤corp♤ Reals</h2>
                            <p class="text-xs text-gray-400">Historias y Reels cortos interactivos almacenados en local.</p>
                        </div>
                        <button onclick="openCreateRealModal()" class="btn-neon px-4 py-2 rounded-xl text-xs font-bold flex items-center gap-2">
                            <i class="fa-solid fa-camera"></i>
                            <span>Publicar Real</span>
                        </button>
                    </div>

                    <!-- Malla de Reals -->
                    <div id="reals-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                        <!-- Tarjetas de Reals -->
                    </div>
                </div>
            </section>

            <!-- SECCIÓN 3: GESTOR DE RED Y WI-FI -->
            <section id="sec-network" class="tab-content hidden flex-1 flex flex-col h-full overflow-y-auto p-4 lg:p-6">
                <div class="max-w-3xl mx-auto w-full space-y-6">
                    <div>
                        <h2 class="text-2xl font-black text-white tracking-wide">Monitor de Red y Wi-Fi</h2>
                        <p class="text-xs text-gray-400">Estadísticas de consumo de datos y configuraciones de sincronización local.</p>
                    </div>

                    <!-- Tarjetas Metricas -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="glass-panel p-4 rounded-2xl border border-white/10">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs text-gray-400">Red Wi-Fi</span>
                                <i class="fa-solid fa-wifi text-emerald-400 text-sm"></i>
                            </div>
                            <p id="wifi-usage-text" class="text-xl font-extrabold text-white">124.8 MB</p>
                            <p class="text-[10px] text-gray-500 mt-1">Conexión activa de alta velocidad</p>
                        </div>
                        <div class="glass-panel p-4 rounded-2xl border border-white/10">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs text-gray-400">Datos Móviles</span>
                                <i class="fa-solid fa-tower-cell text-sky-400 text-sm"></i>
                            </div>
                            <p id="mobile-usage-text" class="text-xl font-extrabold text-white">18.2 MB</p>
                            <p class="text-[10px] text-gray-500 mt-1">Límite mensual prudente</p>
                        </div>
                        <div class="glass-panel p-4 rounded-2xl border border-white/10">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs text-gray-400">Velocidad Simulada</span>
                                <i class="fa-solid fa-bolt text-amber-400 text-sm"></i>
                            </div>
                            <p id="speed-indicator" class="text-xl font-extrabold text-white">45.8 Mbps</p>
                            <p class="text-[10px] text-emerald-400 mt-1"><i class="fa-solid fa-circle text-[8px] mr-1"></i> Latencia: 14ms</p>
                        </div>
                    </div>

                    <!-- Restricción Descargas -->
                    <div class="glass-panel p-6 rounded-2xl border border-white/10 space-y-4">
                        <h3 class="text-sm font-bold text-white tracking-wide uppercase">Ajustes de Descarga de Archivos</h3>
                        
                        <div class="flex items-center justify-between py-2 border-b border-white/5">
                            <div>
                                <p class="text-xs font-semibold text-gray-200">Auto-descarga en Wi-Fi</p>
                                <p class="text-[11px] text-gray-500">Descargar multimedia automáticamente al estar conectado a Wi-Fi.</p>
                            </div>
                            <input type="checkbox" id="toggle-wifi-download" checked onchange="saveNetworkSettings()" class="w-4 h-4 accent-[var(--accent-color)]">
                        </div>

                        <div class="flex items-center justify-between py-2">
                            <div>
                                <p class="text-xs font-semibold text-gray-200">Auto-descarga con Datos Móviles</p>
                                <p class="text-[11px] text-gray-500">Ahorra ancho de banda restringiendo descargas automáticas.</p>
                            </div>
                            <input type="checkbox" id="toggle-mobile-download" onchange="saveNetworkSettings()" class="w-4 h-4 accent-[var(--accent-color)]">
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECCIÓN 4: PERFIL Y SEGUIDORES -->
            <section id="sec-profile" class="tab-content hidden flex-1 flex flex-col h-full overflow-y-auto p-4 lg:p-6">
                <div class="max-w-2xl mx-auto w-full space-y-6">
                    <!-- Header Perfil -->
                    <div class="glass-panel p-6 rounded-3xl border border-white/10 text-center relative overflow-hidden">
                        <div class="w-24 h-24 rounded-2xl btn-neon mx-auto flex items-center justify-center text-3xl font-extrabold text-black mb-4 shadow-xl">
                            <span id="profile-avatar-text">U</span>
                        </div>
                        <h2 id="profile-name-text" class="text-2xl font-bold text-white">Usuario</h2>
                        <p id="profile-pin-tag" class="text-xs font-mono text-[var(--accent-color)] mt-1">#PIN-0000</p>
                        <p id="profile-bio-text" class="text-xs text-gray-300 mt-3 px-4 italic">"Explorando el ecosistema neón de ♤corp♤"</p>

