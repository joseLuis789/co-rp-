                            <button onclick="editProfileModal()" class="px-4 py-2 glass-card rounded-xl text-xs font-semibold text-white hover:bg-white/10 transition-all">
                                Editar Bio
                            </button>
                            <button onclick="shareContactPin()" class="px-4 py-2 btn-neon rounded-xl text-xs font-semibold">
                                Compartir Mi PIN
                            </button>
                        </div>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <!-- MODAL DE CONFIGURACIÓN Y AJUSTES DE APARIENCIA -->
    <div id="settings-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden">
        <div class="glass-panel w-full max-w-md p-6 rounded-3xl border border-white/10 relative max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between mb-4 pb-2 border-b border-white/10">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-palette text-[var(--accent-color)]"></i> Ajustes de Apariencia
                </h3>
                <button onclick="closeSettingsModal()" class="text-gray-400 hover:text-white">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="space-y-5">
                <!-- Temas Neón -->
                <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-2">Tema Neón</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button onclick="setTheme('theme-cyan')" class="p-2 rounded-xl border border-cyan-500/30 bg-cyan-950/30 text-cyan-400 text-xs font-medium hover:border-cyan-400">Cyan</button>
                        <button onclick="setTheme('theme-aurora')" class="p-2 rounded-xl border border-emerald-500/30 bg-emerald-950/30 text-emerald-400 text-xs font-medium hover:border-emerald-400">Aurora</button>
