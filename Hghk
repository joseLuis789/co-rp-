    <!-- SCRIPT PRINCIPAL DE LÓGICA DE LA APP -->
    <script>
        // --- ESTADO GLOBAL LOCALSTORAGE ---
        const DEFAULT_STATE = {
            user: null, // { name, dob, pin, bio }
            chats: [
                {
                    id: 'c1',
                    name: 'Soporte ♤corp♤',
                    pin: '#SP-0001',
                    blocked: false,
                    pinnedMsgId: null,
                    messages: [
                        { id: 'm1', sender: 'them', text: 'Bienvenido a la red privada ♤corp♤.', time: '10:00 AM' }
                    ]
                }
            ],
            reals: [
                { id: 'r1', author: 'Soporte ♤corp♤', caption: '¡Bienvenidos al futuro de la mensajería neón!', likes: 14, liked: false, bg: 'from-purple-600 to-pink-900', views: 89 }
            ],
            followers: ['Elena Rostova', 'Cipher_99', 'Nexus Bot'],
            following: ['Soporte ♤corp♤', 'Kaelen Vance'],
            settings: {
                theme: 'theme-cyan',
                font: 'font-modern',
                waterSphere: true,
                wifiDownload: true,
                mobileDownload: false
            }
        };

        let appState = JSON.parse(localStorage.getItem('corp_app_state')) || DEFAULT_STATE;

        let activeChatId = null;

        // --- INICIALIZACIÓN ---
        window.onload = function() {
            if (!appState.user) {
                document.getElementById('auth-modal').classList.remove('hidden');
            } else {
                initApp();
            }
            initWaterSphere();
        };

        function saveState() {
            localStorage.setItem('corp_app_state', JSON.stringify(appState));
        }

        function registerUser(e) {
            e.preventDefault();
            const name = document.getElementById('auth-name').value.trim();
            const dob = document.getElementById('auth-dob').value;
            const pin = '#SP-' + Math.floor(1000 + Math.random() * 9000);

            appState.user = {
                name: name || 'Usuario',
                dob: dob,
                pin: pin,
                bio: 'Explorando el ecosistema neón de ♤corp♤'
            };

            saveState();
            document.getElementById('auth-modal').classList.add('hidden');
            initApp();
        }

        function initApp() {
            // Aplicar Ajustes
            setTheme(appState.settings.theme || 'theme-cyan');
            setFont(appState.settings.font || 'font-modern');
            document.getElementById('toggle-water-sphere').checked = appState.settings.waterSphere !== false;
            document.getElementById('water-sphere-canvas').style.display = appState.settings.waterSphere !== false ? 'block' : 'none';

            // Actualizar Perfil UI
            document.getElementById('my-pin-display').innerText = appState.user.pin;
            document.getElementById('profile-name-text').innerText = appState.user.name;
            document.getElementById('profile-pin-tag').innerText = appState.user.pin;
            document.getElementById('profile-avatar-text').innerText = appState.user.name.charAt(0).toUpperCase();
            document.getElementById('profile-bio-text').innerText = `"${appState.user.bio}"`;

            updateFollowersCounts();
            renderChatsList();
            renderReals();
