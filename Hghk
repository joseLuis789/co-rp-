        // --- NAVEGACIÓN Y PESTAÑAS ---
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('text-[var(--accent-color)]', 'glow-text'));

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            document.getElementById(`nav-${tabId}`).classList.add('text-[var(--accent-color)]', 'glow-text');
        }

        // --- MÓDULO DE CHATS ---
        function renderChatsList() {
            const listContainer = document.getElementById('chats-list');
            listContainer.innerHTML = '';

            appState.chats.forEach(chat => {
                const lastMsg = chat.messages[chat.messages.length - 1] || { text: 'Sin mensajes', time: '' };
                const div = document.createElement('div');
                div.className = `p-3.5 flex items-center justify-between cursor-pointer hover:bg-white/5 transition-all ${activeChatId === chat.id ? 'bg-white/10 border-l-2 border-[var(--accent-color)]' : ''}`;
                div.onclick = () => openChat(chat.id);

                div.innerHTML = `
                    <div class="flex items-center gap-3 truncate">
                        <div class="w-10 h-10 rounded-xl glass-card flex items-center justify-center font-bold text-xs text-[var(--accent-color)] border border-white/10">
                            ${chat.name.substring(0, 2).toUpperCase()}
                        </div>
                        <div class="truncate">
                            <h4 class="text-xs font-bold text-white truncate flex items-center gap-1.5">
                                ${chat.name}
                                ${chat.blocked ? '<i class="fa-solid fa-ban text-red-400 text-[10px]"></i>' : ''}
                            </h4>
                            <p class="text-[11px] text-gray-400 truncate">${lastMsg.text}</p>
                        </div>
                    </div>
                    <span class="text-[9px] text-gray-500 ml-2">${lastMsg.time}</span>
                `;
                listContainer.appendChild(div);
            });
        }

        function openChat(chatId) {
            activeChatId = chatId;
            const chat = appState.chats.find(c => c.id === chatId);
            if (!chat) return;

            document.getElementById('no-chat-selected').classList.add('hidden');
            const chatWin = document.getElementById('chat-window');
            chatWin.classList.remove('hidden');
            chatWin.classList.add('flex');

            document.getElementById('active-chat-container').classList.remove('hidden');

            document.getElementById('chat-title').innerText = chat.name;
            document.getElementById('chat-subtitle').innerText = `PIN: ${chat.pin}`;
            document.getElementById('chat-avatar').innerText = chat.name.substring(0, 2).toUpperCase();

            // Actualizar estado de bloqueo
            const blockBtn = document.getElementById('btn-toggle-block');
            blockBtn.innerHTML = chat.blocked ? '<i class="fa-solid fa-unlock"></i>' : '<i class="fa-solid fa-ban"></i>';

            renderMessages();
            renderChatsList();
        }

        function closeChatMobile() {
            document.getElementById('active-chat-container').classList.add('hidden');
        }

        function renderMessages() {
            const chat = appState.chats.find(c => c.id === activeChatId);
            if (!chat) return;

            const container = document.getElementById('messages-container');
            container.innerHTML = '';

            // Mostrar Barra Fijada si existe
            const pinnedBar = document.getElementById('pinned-message-bar');
            if (chat.pinnedMsgId) {
                const pinnedMsg = chat.messages.find(m => m.id === chat.pinnedMsgId);
                if (pinnedMsg) {
                    pinnedBar.classList.remove('hidden');
                    document.getElementById('pinned-text').innerText = pinnedMsg.text;
                }
            } else {
                pinnedBar.classList.add('hidden');
            }

            chat.messages.forEach(msg => {
                const isMe = msg.sender === 'me';
                const msgDiv = document.createElement('div');
                msgDiv.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'} my-1 group`;

                msgDiv.innerHTML = `
                    <div class="max-w-[80%] rounded-2xl px-4 py-2.5 text-xs relative ${isMe ? 'btn-neon text-black rounded-tr-none' : 'glass-panel text-white rounded-tl-none border border-white/10'}">
                        <p>${msg.text}</p>
                        <div class="flex items-center justify-end gap-1 mt-1 text-[9px] opacity-70">
                            <span>${msg.time}</span>
                            ${isMe ? '<i class="fa-solid fa-check-double"></i>' : ''}
                        </div>
                    </div>
                    <div class="opacity-0 group-hover:opacity-100 transition-opacity flex gap-2 text-[10px] text-gray-400 mt-0.5 px-1">
                        <button onclick="pinMessage('${msg.id}')" class="hover:text-[var(--accent-color)]"><i class="fa-solid fa-thumbtack"></i> Fijar</button>
                    </div>
                `;
                container.appendChild(msgDiv);
            });

            container.scrollTop = container.scrollHeight;
        }

        function sendMessage(e) {
            e.preventDefault();
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text || !activeChatId) return;

            const chat = appState.chats.find(c => c.id === activeChatId);
            if (chat.blocked) {
                alert('Este contacto está bloqueado.');
                return;
            }

            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            chat.messages.push({
                id: 'm_' + Date.now(),
                sender: 'me',
                text: text,
                time: timeStr
            });

            input.value = '';
            saveState();
            renderMessages();
            renderChatsList();

            // Respuesta Automática simulada
            setTimeout(() => {
                chat.messages.push({
                    id: 'm_' + (Date.now() + 1),
                    sender: 'them',
                    text: 'Respuesta automática de eco neón: ' + text,
                    time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                });
                saveState();
                if (activeChatId === chat.id) renderMessages();
                renderChatsList();
            }, 1200);
        }

        function pinMessage(msgId) {
            const chat = appState.chats.find(c => c.id === activeChatId);
            if (chat) {
                chat.pinnedMsgId = msgId;
                saveState();
                renderMessages();
            }
        }

        function unpinMessage() {
            const chat = appState.chats.find(c => c.id === activeChatId);
            if (chat) {
                chat.pinnedMsgId = null;
                saveState();
                renderMessages();
            }
        }

        function toggleBlockContact() {
            const chat = appState.chats.find(c => c.id === activeChatId);
            if (chat) {
                chat.blocked = !chat.blocked;
                saveState();
                openChat(chat.id);
            }
        }

